{
  "name": "@harrarz/pi-agnostic-subagents",
  "version": "0.2.0",
  "license": "MIT",
  "author": "harrarz",
  "keywords": ["pi-package", "pi-extension", "subagents", "coding-agents"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrarz/pi-agnostic-subagents.git"
  },
  "homepage": "https://github.com/harrarz/pi-agnostic-subagents#readme",
  "bugs": "https://github.com/harrarz/pi-agnostic-subagents/issues",
  "publishConfig": { "access": "public" },
  "files": ["src", "docs/configuration.md", "README.md", "LICENSE", "CHANGELOG.md"],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Agent-agnostic subagents for Pi: launch, inspect, steer, resume, and stop coding CLIs",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:tui": "python3 test/fixtures/tui-smoke.py",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run check:package",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2"
  }
}
